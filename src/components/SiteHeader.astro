---
/**
 * This site's nav. The furniture is shared (198x-ui); the routes are not — a
 * shared nav that knew them would have to be edited to add a page here.
 *
 * The wrapper only makes the shared nav sticky, which this site's header has
 * always been. Everything else about it comes from the kit.
 */
import SiteNav from '@198x-ui/components/SiteNav.astro';

const items = [
  { label: 'Start', href: '/docs/getting-started/' },
  { label: 'Download', href: '/downloads/' },
  { label: 'Accuracy', href: '/accuracy/' },
  { label: 'Systems', href: '/systems/' },
  { label: 'Status', href: '/docs/status/current-system-usability/' },
  { label: 'MCP', href: '/docs/features/mcp/' },
  { label: 'Docs', href: '/docs/' },
];
---

<div class="site-header" data-pagefind-ignore>
  <SiteNav prefix="emu" project="emu" items={items} />
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
  }
</style>
