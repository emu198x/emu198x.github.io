---
import catalog from '../../public/emulators/catalog.json';
import {browserPlayerFor} from '../lib/browser-player.js';
interface Props { system: string }
const player = browserPlayerFor(Astro.props.system, catalog);
const entry = player?.entry;
const display = entry?.kind === 'game-boy' ? [480, '160 / 144'] : entry?.kind === 'nes' ? [640, '256 / 240'] : [760, entry?.kind === 'spectrum' ? '352 / 296' : entry?.kind === 'c64' ? '416 / 312' : '768 / 576'];
---
{entry && <section class="browser-player" aria-label={`${entry.name} player`}>
  <h2>Play {entry.name}</h2>
  <emu198x-player system={entry.id} variant={player.variant} style={`--player-width: ${display[0]}px; --player-ratio: ${display[1]}`} >
    <div class="player-placeholder" role="status">Loading player…</div>
  </emu198x-player>
  <noscript><p>Enable JavaScript to use the emulator.</p></noscript>
  <p class="desktop-download" style={`max-width: ${display[0]}px`}><a href="/downloads/">Download Emu198x for desktop</a></p>
</section>}
<script is:inline type="module" src="/emulators/embed.js"></script>
<style>
  .browser-player { margin: 2.5rem 0; --player-ink: var(--ink); --player-muted: var(--ink-muted); --player-line: var(--line); --player-surface: var(--paper-strong); --player-focus: var(--ink); }
  h2 { font-size: 1.4rem; line-height: 1.3; margin: 0 0 1rem; }
  emu198x-player { display: block; max-width: var(--player-width); margin-inline: auto; }
  .desktop-download { margin: .75rem auto 0; font-size: .9rem; }
  .desktop-download a { display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: .2em; }
  .player-placeholder { display: grid; place-items: center; aspect-ratio: var(--player-ratio); background: #11151a; color: #eef2f6; margin-bottom: 8rem; border-radius: 3px; }
</style>
