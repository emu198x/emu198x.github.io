---
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadSiteData } from '@lib/site-data.js';
import { countByGroup } from '@lib/fleet.js';

// Measured from the registry, never typed here. These three numbers were
// literals — 6 / 22 / 28 — and this branch made them wrong: the fleet is 6
// primary and 24 extended, so / would have said 28 runtimes while /systems/
// said 30 machines in the same build. 28 is the stale figure fleet.js names as
// the bug this rebuild exists to remove, so it must not be re-typed with
// today's values; it has to come from the same data /systems/ counts.
//
// Primary and Extended are counted strictly, from each machine's own boot
// capture. Neither is derived as the other's remainder: a machine whose
// surface is not stated would then be silently filed under one of them, which
// is the kind of unmeasured claim this page just stopped making.
const { fleet } = loadSiteData();
const groups = countByGroup(fleet);
const primaryCount = groups.get('Primary') ?? 0;
const extendedCount = groups.get('Extended') ?? 0;
// Every machine in the registry ships as a scriptable, MCP-driven runtime,
// primary and extended alike — so this is the registry's own size.
const runtimeCount = fleet.length;
---

<BaseLayout title="Emu198x" description="A public evidence site for the Emu198x multi-system emulator suite.">
  <main data-pagefind-body>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Multi-system emulator suite</p>
          <h1>Emu198x</h1>
          <p class="lede">
            Cycle-accurate vintage computers and consoles with one deterministic
            automation surface, public accuracy evidence, and hardware-aware
            documentation.
          </p>
          <div class="actions">
            <a class="button primary" href="/downloads/">Download</a>{' '}
            <a class="button secondary" href="/docs/getting-started/">Get started</a>{' '}
            <a class="button secondary" href="/accuracy/">Accuracy progress</a>{' '}
            <a class="button secondary" href="/systems/">System matrix</a>
          </div>
        </div>
        <div class="evidence-panel" aria-label="Current Emu198x support summary">
          <div class="panel-header">
            <span class="pill">Current fleet</span>
            <span>July 2026</span>
          </div>
          <div class="stat-grid">
            <div class="stat"><strong>{primaryCount}</strong><span>primary systems</span></div>
            <div class="stat"><strong>{extendedCount}</strong><span>extended systems</span></div>
            <div class="stat"><strong>{runtimeCount}</strong><span>MCP-driven runtimes</span></div>
            <div class="stat"><strong>All</strong><span>supported systems tracked</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="container section-grid" aria-label="Project priorities">
      <article>
        <p class="eyebrow">Accuracy</p>
        <h2>Claims backed by dashboards.</h2>
        <p>
          The site exists to make emulator claims inspectable across every
          supported system: test canons, pass rates, known failures,
          compatibility sweeps, and measurement provenance.
        </p>
      </article>
      <article>
        <p class="eyebrow">Tooling</p>
        <h2>One control surface across the fleet.</h2>
        <p>
          Capture, scripting, snapshots, and MCP let tools and agents drive
          different machines consistently without flattening their internals.
        </p>
      </article>
      <article>
        <p class="eyebrow">Scope</p>
        <h2>Machine-specific timing stays machine-specific.</h2>
        <p>
          Shared infrastructure lives above the cores. Video, audio, DMA, media,
          and bus arbitration stay in the family that owns the hardware.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--h-accent) 12%, transparent), transparent 42%),
      var(--paper);
  }

  .hero-grid {
    display: grid;
    min-height: calc(100svh - 64px);
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 4rem;
    align-items: center;
    padding-block: 4rem;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    /* 12vw already overran this column in the old system-font fallback (621px
       into 586px); Archivo is wider again and brought the last glyph up against
       the evidence panel. Measured at 1024/1280/1440: this clears the panel at
       every width, and at the 8rem ceiling the headline sits inside its column
       instead of bleeding into the grid gap. */
    font-size: clamp(4rem, 10.5vw, 8rem);
    line-height: 0.86;
  }

  .lede {
    max-width: 680px;
    margin: 1.4rem 0 0;
    font-size: clamp(1.2rem, 2.1vw, 1.55rem);
    line-height: 1.48;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    padding: 0 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: var(--accent);
    color: var(--ink-on-accent);
  }

  .secondary {
    background: var(--panel);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .evidence-panel {
    border-radius: var(--radius);
    padding: 1rem;
    background: color-mix(in oklab, var(--h-page) 72%, transparent);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-md);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 4rem;
  }

  .section-grid article {
    min-width: 0;
  }

  .section-grid h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.06;
  }

  .section-grid p:last-child {
    margin-bottom: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      background: var(--accent-strong);
      color: var(--ink-on-accent);
    }

    .secondary:hover {
      background: var(--paper-strong);
      color: var(--accent-strong);
    }
  }

  @media (max-width: 900px) {
    .hero-grid,
    .section-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      min-height: auto;
      gap: 2rem;
    }
  }
</style>
