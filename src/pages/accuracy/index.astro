---
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadSiteData } from '@lib/site-data.js';

const { fleet, evidence } = loadSiteData();

const rows = fleet.map((entry) => ({
  entry,
  evidence: evidence.get(entry.machineId),
  boot: entry.captures.find((capture) => capture.kind === 'boot') ?? null,
}));

const capturedCount = rows.filter((row) => row.boot).length;
const uncapturedCount = rows.length - capturedCount;

const sourceTiers = [
  {
    tier: '1',
    label: 'Real hardware capture',
    description: 'Digital capture from an original machine. This is the strongest visual source when geometry, timing, and capture conditions are known.',
  },
  {
    tier: '2',
    label: 'Hardware-validated test image',
    description: 'A test ROM or program with reference output verified against real silicon, such as acid tests or emulator test-suite screenshots.',
  },
  {
    tier: '3',
    label: 'Reference emulator capture',
    description: 'A capture from a mature emulator with version and configuration recorded. This proves agreement with that emulator, not final accuracy by itself.',
  },
  {
    tier: '4',
    label: 'Emu198x golden',
    description: 'A self-minted regression image. Useful for detecting drift, but not enough to settle whether the rendering is correct.',
  },
];

const comparisonRules = [
  'Record the exact emulator, version or vendored snapshot, machine model, firmware, media, and command/configuration.',
  'Treat source-available emulators as implementation references; treat binary-only emulators as verification runs, not code citations.',
  'Prefer independent codebases. Downstream forks are useful for workflow checks, but they do not count as independent agreement.',
  'Separate software-emulator agreement from signal-level FPGA agreement. Both are useful, but they answer different questions.',
  'Use comparison captures to explain agreement or disagreement; do not replace real hardware or hardware-validated tests with emulator screenshots.',
];

const referenceSources = [
  {
    system: 'ZX Spectrum family',
    primary: 'Fuse is the canonical broad FOSS reference. ZEsarUX is the readable contention cross-check.',
    secondary: 'Spectron covers 16K, 48K, 128K, and TC2048. SpecIde, EightyOne, zxsp, and the MiSTer core are tie-breakers.',
    status: 'Partial',
    notes: 'Spectron is useful but not enough for +2/+2A/+2B/+3, Pentagon, Scorpion, TC2068, or TS2068. Those need Fuse, ZEsarUX, EightyOne, zxsp, MiSTer, or hardware-backed captures.',
  },
  {
    system: 'Commodore 64',
    primary: 'VICE is the established reference and includes reSID for SID behaviour.',
    secondary: 'VirtualC64, Frodo SC, Hoxs64, and the C64 MiSTer core give independent or signal-level checks.',
    status: 'Strong',
    notes: 'Best fit for VIC-II, CIA, SID, IEC, drive-path, and software corpus comparisons. Document disagreements instead of picking a silent winner.',
  },
  {
    system: 'Nintendo NES',
    primary: 'Mesen2 is the first software reference for NES and Famicom work.',
    secondary: 'ares, fceux, nestopia, and the NES MiSTer core give second opinions and signal-level checks.',
    status: 'Strong',
    notes: 'Use test ROM result channels where possible; use screenshots for PPU presentation and timing evidence.',
  },
  {
    system: 'Nintendo Game Boy',
    primary: 'SameBoy is the local source-available reference for DMG, MGB, SGB, SGB2, CGB, and AGB modes.',
    secondary: 'ares can be used as a multi-system second opinion where useful.',
    status: 'Strong',
    notes: 'Pair emulator comparisons with hardware-validated suites such as dmg-acid2, cgb-acid2, and mealybug-tearoom.',
  },
  {
    system: 'Commodore Amiga',
    primary: 'vAmiga first for readable OCS/ECS behaviour; WinUAE first for breadth and AGA.',
    secondary: 'WinFellow is an independent OCS/ECS comparator. fs-uae is useful operationally but is downstream of WinUAE. Minimig-AGA MiSTer is the signal-level comparison.',
    status: 'Partial',
    notes: 'AGA-specific work is mostly WinUAE plus Minimig. Workbench and game captures must record model, Kickstart, RAM, chipset, and disk configuration.',
  },
  {
    system: 'Dragon / CoCo',
    primary: 'XRoar is the local source-available reference for Dragon 32/64 and Tandy CoCo 1/2/3.',
    secondary: 'Real-hardware or published captures are the main tie-breakers when available.',
    status: 'Usable',
    notes: 'Already useful for Dragon software, 6809-family behaviour, and display-path cross-checks.',
  },
  {
    system: 'TMS9918-family machines',
    primary: 'ares is the local multi-system reference for MSX, ColecoVision, SG-1000, and related VDP/SN76489 paths.',
    secondary: 'openMSX and blueMSX are good external candidates, but they are not currently vendored here.',
    status: 'Partial',
    notes: 'Treat this as a chip-keyed source: one VDP oracle strategy can cover MSX1, ColecoVision, SG-1000, Sord M5, Einstein, and SVI-328, but machine-specific firmware/media still matters.',
  },
  {
    system: 'Atari 2600 / 8-bit / 5200 / 7800',
    primary: 'Stella is the 2600 reference. Altirra is the Atari 8-bit and 5200 reference, paired with acid800 tests.',
    secondary: 'Atari800 MiSTer and Atari7800 MiSTer provide signal-level checks. A7800 remains an external candidate for 7800 software-emulator comparison.',
    status: 'Partial',
    notes: '2600 and 8-bit coverage is strong; 7800 needs a better software-emulator comparison path. Use cartridge-specific captures only with local media and clear provenance.',
  },
  {
    system: 'Commodore VIC-20 / PET',
    primary: 'VICE covers VIC-20 and PET as well as C64.',
    secondary: 'VIC20 MiSTer is available as a signal-level VIC-20 comparator.',
    status: 'Usable',
    notes: 'PET still needs a stronger independent comparison source or hardware-backed captures for model-specific behaviour.',
  },
  {
    system: 'ZX80 / ZX81 / Jupiter Ace',
    primary: 'EightyOne is the local broad reference for the ZX81, TS1000/1500, Jupiter Ace, and Spectrum-adjacent lineage.',
    secondary: 'Primary-library timing references and hardware captures are needed for edge cases.',
    status: 'Usable',
    notes: 'Useful for boot and display comparisons, but still weaker than the Spectrum reference stack.',
  },
  {
    system: 'Acorn Atom / Electron / BBC Micro',
    primary: 'BBCMicro MiSTer is the only local BBC reference implementation.',
    secondary: 'b2, BeebEm, and JSBeeb are external candidates; Atom and Electron need reference candidates chosen.',
    status: 'Gap',
    notes: 'Use the primary library and hardware-backed captures until software references are vendored or otherwise pinned.',
  },
  {
    system: 'Oric / Memotech / Aquarius',
    primary: 'No strong local reference-emulator set is currently vendored for these machines.',
    secondary: 'MEMU-informed MTX work exists in Emu198x notes, but the public comparison source still needs to be pinned.',
    status: 'Gap',
    notes: 'Do not imply visual accuracy from Emu198x goldens alone. These need external reference selection or hardware-backed captures.',
  },
];
---

<BaseLayout title="Accuracy Progress" description="Fleet-wide Emu198x accuracy evidence across every registry machine.">
  <main class="container accuracy" data-pagefind-body>
    <header>
      <p class="eyebrow">Fleet-wide evidence</p>
      <h1>Accuracy progress</h1>
      <p>
        Every machine in the flagship's registry is listed here, driven from
        the same source as the system matrix. The table below shows what can
        be evidenced today: own and shared crate counts, whether a boot
        capture exists, and where each machine's open work is tracked.
      </p>
      <p>
        There are no percentages or maturity scores on this page. The
        flagship's own status page publishes no test counts on purpose: they
        "would be stale within a day, and a page that is usually wrong trains
        people to stop reading it." A crate count and a link to open issues
        are honest; a hand-typed score is not.
      </p>
    </header>

    <section class="stat-grid" aria-label="Fleet evidence summary">
      <div class="stat"><strong>{rows.length}</strong><span>machines in the registry</span></div>
      <div class="stat"><strong>{capturedCount}</strong><span>with a boot capture</span></div>
      <div class="stat"><strong>{uncapturedCount}</strong><span>no capture yet</span></div>
    </section>

    <section class="panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Evidence table</p>
          <h2>Current evidence by system</h2>
        </div>
        <a href="/docs/status/current-system-usability/">Source status matrix</a>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Current evidence by system">
        <table>
          <thead>
            <tr>
              <th>System</th>
              <th>Own crates</th>
              <th>Shared crates</th>
              <th>Boot capture</th>
              <th>Issues</th>
              <th>Milestone</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ entry, evidence, boot }) => (
              <tr>
                <td><a href={`/systems/${entry.machineId}/`}>{entry.machineId}</a></td>
                <td>{evidence.ownCrates}</td>
                <td>{evidence.sharedCrates}</td>
                <td>{boot ? 'Yes' : 'No capture yet'}</td>
                <td><a href={evidence.issuesUrl}>Open issues</a></td>
                <td><a href={evidence.milestoneUrl}>Milestone</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Visual sources</p>
          <h2>What counts as evidence</h2>
        </div>
      </div>
      <p>
        Screenshot comparisons are only meaningful when the source is labelled.
        Emu198x treats screenshots as evidence about the digital framebuffer:
        pixel geometry, timing, and rendered content. Palette choices and CRT
        effects are documented separately.
      </p>
      <div class="tier-grid">
        {sourceTiers.map((source) => (
          <article class="tier-card">
            <strong>Tier {source.tier}</strong>
            <h3>{source.label}</h3>
            <p>{source.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Comparison policy</p>
          <h2>What makes a comparison valid</h2>
        </div>
      </div>
      <p>
        A reference-emulator comparison is valid when the run can be repeated
        and the source is honest about its limits. Agreement with a mature
        emulator is useful evidence, but it is not the same thing as proof
        against original hardware.
      </p>
      <ul class="rule-list">
        {comparisonRules.map((rule) => (
          <li>{rule}</li>
        ))}
      </ul>
    </section>

    <section class="panel reference-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Reference candidates</p>
          <h2>Comparison sources by family</h2>
        </div>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Comparison sources by family">
        <table>
          <thead>
            <tr>
              <th>Family</th>
              <th>Primary reference</th>
              <th>Secondary / tie-breakers</th>
              <th>Coverage</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {referenceSources.map((source) => (
              <tr>
                <td>{source.system}</td>
                <td>{source.primary}</td>
                <td>{source.secondary}</td>
                <td><span class={`status reference-${source.status.toLowerCase()}`}>{source.status}</span></td>
                <td>{source.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="notes">
      <h2>How to read this</h2>
      <p>
        A crate count and a boot capture are evidence about what has been
        built and seen to run. They are not a compatibility guarantee, and
        they say nothing about how much of a machine remains untested.
        Follow the system links for the detail behind each row.
      </p>
      <p>
        When sources disagree, the closest source to real hardware wins.
        Lower-tier disagreements remain useful, but they are tracked as
        adjudication work rather than silently replacing a golden image.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .accuracy {
    padding-top: 4rem;
  }

  header {
    max-width: 900px;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 9vw, 7rem);
    line-height: 0.9;
  }

  header p:last-child {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.58;
  }

  .stat-grid {
    margin-top: 2rem;
  }

  .panel,
  .notes {
    margin-top: 2rem;
    border-radius: var(--radius);
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-sm);
  }

  .panel-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .panel-heading h2,
  .notes h2 {
    margin: 0;
  }

  .panel-heading a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-weight: 650;
    white-space: nowrap;
  }

  .panel > p {
    max-width: 880px;
    margin-top: 0;
    line-height: 1.55;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .tier-card {
    border-radius: var(--radius);
    padding: 1rem;
    background: var(--paper-strong);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tier-card strong {
    color: var(--accent-strong);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tier-card h3 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1rem;
  }

  .tier-card p {
    margin: 0;
    line-height: 1.45;
  }

  .rule-list {
    max-width: 900px;
    margin: 1rem 0 0;
    padding-left: 1.2rem;
  }

  .rule-list li {
    margin-top: 0.55rem;
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .table-wrap {
    overflow-x: auto;
  }

  td:first-child,
  th:first-child {
    min-width: 170px;
  }

  .reference-panel td:nth-child(2),
  .reference-panel td:nth-child(3),
  .reference-panel td:nth-child(5) {
    min-width: 320px;
  }

  .status {
    display: inline-flex;
    min-height: 1.8rem;
    align-items: center;
    border-radius: 999px;
    padding: 0 0.65rem;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* Coverage runs Strong > Usable > Partial > Gap. It used to be keyed by hue
     (teal / blue / red), which does not survive the family palette: the old
     teal is retired, and a blue here would sit next to the Emu198x project
     colour, which family-visual-identity.md §3 keeps inside the plate. So the
     states are one hue at descending intensity — filled, outlined, neutral
     outline, faint — which orders them and works in both themes. The label is
     its own legend, so colour is not carrying the meaning alone. */
  .reference-usable {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--h-accent);
    color: var(--accent-strong);
  }

  .reference-partial {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--h-line);
    color: var(--h-ink-body);
  }

  .reference-gap {
    background: transparent;
    color: var(--h-ink-muted);
  }

  @media (max-width: 760px) {
    .panel-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
