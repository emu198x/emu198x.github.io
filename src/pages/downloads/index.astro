---
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadSiteData } from '@lib/site-data.js';
import { bootCapture } from '@lib/fleet.js';
import {
  TARGETS,
  archiveCount,
  buildMatrix,
  checksumsUrl,
  readLatestVersion,
  readReleaseManifest,
  releaseUrl,
} from '@lib/releases.js';

// The machine axis comes from the flagship's registry, exactly as /systems/
// and the homepage take it. This page used to name six binaries against a
// release of thirty, because the six were typed here and nothing made them
// wrong when the release grew. Nothing is typed here now: a machine added
// upstream appears in this list on the next build.
const { fleet, sourceRoot } = loadSiteData();
const version = readLatestVersion(sourceRoot);
const releaseAssets = await readReleaseManifest(version);

// The human name lives on the machine's boot capture, so the name a reader
// sees here is the name /systems/ shows on the same machine's card. A machine
// that reaches the registry before it has a capture still lists its archives,
// under its registry id — a missing display name must not remove a download.
const matrix = buildMatrix({
  machines: fleet.map((entry) => ({ ...entry, name: bootCapture(entry)?.name ?? entry.machineId })),
  version,
  releaseAssets,
});

// Counted from the matrix that was just built, never typed beside it.
const machineCount = matrix.length;
const targetCount = TARGETS.length;
const archives = archiveCount(matrix);
const example = matrix.find((machine) => machine.crate === 'emu198x-spectrum') ?? matrix[0];
const exampleArchive = example.builds[0].file;
const exampleDir = exampleArchive.replace(/\.tar\.xz$/, '');
---

<BaseLayout
  title="Downloads"
  description="Every Emu198x release archive: one binary per machine, built for macOS, Windows and Linux."
>
  <main class="container downloads" data-pagefind-body>
    <p class="eyebrow">Releases</p>
    <h1>Download Emu198x</h1>

    <section class="intro">
      <p class="lede">
        Emu198x ships one binary per machine. Pick the machine you want, take
        the archive for your operating system, unpack it, and run the binary
        inside.
      </p>
      <div class="actions" data-pagefind-ignore>
        <a class="button primary" href={releaseUrl(version)}>Release {version} notes</a>{' '}
        <a class="button secondary" href="https://github.com/emu198x/emu198x/releases">
          All releases
        </a>{' '}
        <a class="button secondary" href="/docs/getting-started/">Getting started</a>
      </div>
    </section>

    <section class="stat-grid" aria-label="What this release contains">
      <div class="stat"><strong>{version}</strong><span>current release</span></div>
      <div class="stat"><strong>{machineCount}</strong><span>machines</span></div>
      <div class="stat"><strong>{targetCount}</strong><span>desktop targets</span></div>
      <div class="stat"><strong>{archives}</strong><span>archives in all</span></div>
    </section>

    <section aria-labelledby="matrix-heading">
      <h2 id="matrix-heading">Every machine, every target</h2>

      <div class="platform-panel">
        {/* role="status" so the one sentence a script rewrites reaches a
            screen reader as well as the screen. The wording below is what a
            reader gets with no script at all, and it has to stand on its
            own: this is a static site, so there is no server-side detection
            to fall back on. */}
        <p id="platform-note" class="platform-note" role="status">
          Every archive is listed below, for all {machineCount} machines and all {targetCount} targets.
        </p>
        <p class="platform-detail">
          macOS comes in two builds. Apple silicon leads, for an M1 or later
          Mac; Intel follows, for a Mac built before it. A browser cannot
          always tell the two apart — Safari names an Intel processor on every
          Mac, including Apple silicon — so both stay listed and neither is
          marked unless your browser reports the architecture outright.
          Windows and Linux have one build each. Nothing here is ever hidden:
          if you are fetching an archive for a different machine, it is on
          this page.
        </p>
      </div>

      <ul class="machines">
        {matrix.map((machine) => (
          <li class="machine">
            <div class="machine-head">
              <h3><a href={`/systems/${machine.machineId}/`}>{machine.name}</a></h3>
              <p class="crate"><code>{machine.crate}</code></p>
            </div>
            <ul class="builds" data-builds>
              {machine.builds.map((build) => (
                <li class="build" data-os={build.target.os} data-arch={build.target.arch}>
                  <a href={build.url}>
                    <span class="sr-only">{machine.name}, </span>
                    <span class="build-name">{build.target.osLabel}, {build.target.archLabel}</span>
                    <span class="build-hint">{build.target.hint}, {build.target.ext}</span>
                    <span class="build-match" data-match hidden>Matches your platform</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Check what you downloaded</h2>
      <p>
        Every archive in the release carries a SHA-256 sum, and{' '}
        <a href={checksumsUrl(version)}>one file lists them all</a>. Each
        archive also ships its own <code>.sha256</code> beside it on the
        release page. Hash the file you fetched and compare it with the line
        for that name:
      </p>
      <pre tabindex="0"><code>shasum -a 256 {exampleArchive}</code></pre>
    </section>

    <section>
      <h2>Run the binary</h2>
      <p>
        Each archive unpacks to a directory of the same name holding the
        binary, a README, a changelog and the licence. Unpack it and run the
        binary from inside:
      </p>
      <pre tabindex="0"><code>tar -xf {exampleArchive}
cd {exampleDir}
./{example.crate} --script boot.json</code></pre>
      <p>
        On Windows the archive is a <code>.zip</code>; unpack it and run the{' '}
        <code>.exe</code> the same way.
      </p>
      <p>
        The documentation reaches for <code>cargo run</code> because that form
        works straight from a source checkout. With a release archive, name
        the unpacked binary instead. Both take the same flags:
      </p>
      <pre tabindex="0"><code># From a source checkout
cargo run --release -p emu198x-nes -- \
  --rom game.nes \
  --frames 300 \
  --screenshot nes.png

# From a release archive
./emu198x-nes --rom game.nes --frames 300 --screenshot nes.png</code></pre>
      <p>
        Scripting and MCP need no special build. See{' '}
        <a href="/docs/scripting/">scripting</a> for the JSON session format
        and <a href="/docs/mcp/">MCP</a> for driving a machine from a client.
      </p>
    </section>

    <section>
      <h2>ROMs, firmware, and media</h2>
      <p>
        Emu198x does not ship commercial ROMs, firmware, disks, tapes, or
        cartridges. You provide those yourself from hardware you own or another
        legal source. Some machines start from a cartridge or disk image;
        others need a local firmware path before they can boot.{' '}
        <a href="/systems/">The system matrix</a> records what each one asks
        for.
      </p>
    </section>

    <section>
      <h2>Build from source</h2>
      <p>
        A source build is still the right path for development work and for
        changes that have not reached a release yet. The{' '}
        <a href="/docs/getting-started/">getting started guide</a> covers the
        checkout.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  /**
   * Detection reorders and marks. It never filters.
   *
   * Every archive is already in the HTML before this runs, and this script
   * moves list items that are there and unhides a label that is there. It
   * removes nothing, so a reader whose platform is detected wrongly — or not
   * at all — still has all 120 archives in front of them.
   *
   * The architecture question is the one that cannot be answered from the
   * user-agent string. Safari reports `Intel Mac OS X` on Apple silicon, so
   * parsing the string would answer confidently and wrongly on most Macs
   * sold since 2020. `getHighEntropyValues` answers it on Chromium and
   * nowhere else, so where it is absent both Mac builds are offered and
   * neither is marked.
   */
  type Platform = { os: string | null; arch: string | null };

  const NOTES: Record<string, string> = {
    windows:
      'Your browser reports Windows, so the Windows build is listed first for each machine. Every other build is still here.',
    linux:
      'Your browser reports Linux, so the Linux build is listed first for each machine. Every other build is still here.',
    'macos-arm64':
      'Your browser reports macOS on Apple silicon, so that build is marked for each machine. The Intel build is listed beside it, and every other build is still here.',
    macos:
      'Your browser reports macOS but not which processor, so both Mac builds are listed for each machine, Apple silicon first. Pick Apple silicon for an M1 or later Mac.',
  };

  function osFromClientHints(data: any): string | null {
    const platform = data?.platform;
    if (platform === 'macOS') return 'macos';
    if (platform === 'Windows') return 'windows';
    if (platform === 'Linux') return 'linux';
    return null;
  }

  // Used for the operating system only, never for the architecture. Android
  // and Chrome OS both carry "Linux" in the string and neither is a target
  // this release builds, so they resolve to nothing rather than to a build
  // that would not run.
  function osFromUserAgent(agent: string): string | null {
    if (/Android|CrOS/.test(agent)) return null;
    if (/Windows/.test(agent)) return 'windows';
    if (/Mac OS X|Macintosh/.test(agent)) return 'macos';
    if (/Linux|X11/.test(agent)) return 'linux';
    return null;
  }

  async function detect(): Promise<Platform> {
    const data = (navigator as any).userAgentData;
    const os = osFromClientHints(data) ?? osFromUserAgent(navigator.userAgent);
    let arch: string | null = null;

    // Only `arm` preselects. A Chromium running under Rosetta on Apple
    // silicon reports `x86`, so treating x86 as proof of an Intel Mac would
    // send those readers to the slower build with a confident label on it.
    // An unmarked pair is the honest answer where the answer is unknown.
    if (os === 'macos' && typeof data?.getHighEntropyValues === 'function') {
      try {
        const values = await data.getHighEntropyValues(['architecture']);
        if (values?.architecture === 'arm') arch = 'arm64';
      } catch {
        arch = null;
      }
    }

    return { os, arch };
  }

  function apply({ os, arch }: Platform) {
    if (!os) return;

    const note = document.getElementById('platform-note');
    if (note) note.textContent = NOTES[`${os}-${arch}`] ?? NOTES[os] ?? note.textContent;

    for (const list of document.querySelectorAll<HTMLElement>('[data-builds]')) {
      const items = [...list.querySelectorAll<HTMLElement>('.build')];
      const mine = items.filter((item) => item.dataset.os === os);
      if (mine.length === 0) continue;

      // prepend takes them all at once and keeps the authored order, which is
      // what puts Apple silicon ahead of Intel on a Mac.
      list.prepend(...mine);

      // One build for this operating system means detecting the system
      // resolved it. Two means the architecture has to say so — and on macOS
      // only `arm` does. Asking the list rather than assuming Windows and
      // Linux have one build each keeps that true if the release grows one.
      const chosen =
        mine.length === 1 ? mine[0] : mine.find((item) => item.dataset.arch === arch) ?? null;
      if (!chosen) continue;

      chosen.classList.add('is-match');
      chosen.querySelector('[data-match]')?.removeAttribute('hidden');
    }
  }

  detect().then(apply);
</script>

<style>
  .downloads {
    padding-block: 4rem;
  }

  h1 {
    max-width: 920px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.2rem, 9vw, 7rem);
    line-height: 0.9;
  }

  h2 {
    margin-top: 0;
    color: var(--ink);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.08;
  }

  section {
    margin-top: 3rem;
  }

  .intro {
    max-width: 860px;
  }

  .lede {
    margin: 1.35rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.42rem);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    padding: 0 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: var(--accent);
    color: var(--ink-on-accent);
  }

  .secondary {
    background: var(--panel);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .platform-panel {
    margin-top: 1.5rem;
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-sm);
  }

  .platform-note {
    margin: 0;
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .platform-detail {
    max-width: 74ch;
    margin: 0.7rem 0 0;
  }

  .machines {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .machine {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    border-radius: var(--radius);
    padding: 1.15rem 1.2rem 1.3rem;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-sm);
  }

  .machine-head h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.16rem;
    line-height: 1.2;
  }

  .machine-head h3 a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }

  .crate {
    margin: 0.3rem 0 0;
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }

  .crate code {
    color: var(--ink-muted);
  }

  .builds {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .build a {
    display: block;
    min-height: 44px;
    border-radius: 7px;
    padding: 0.5rem 0.7rem;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    text-decoration: none;
  }

  .build-name {
    display: block;
    color: var(--accent-strong);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .build-hint {
    display: block;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  /* The marked build is never marked by colour alone: this label appears with
     it, and the item moves to the front of its list. */
  .build-match[hidden] {
    display: none;
  }

  .build-match {
    display: block;
    margin-top: 0.25rem;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .build.is-match a {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  p,
  li {
    color: var(--ink-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      background: var(--accent-strong);
      color: var(--ink-on-accent);
    }

    .secondary:hover {
      background: var(--paper-strong);
      color: var(--accent-strong);
    }

    .build a:hover {
      background: var(--accent-soft);
      box-shadow: inset 0 0 0 1px var(--accent);
    }
  }
</style>
