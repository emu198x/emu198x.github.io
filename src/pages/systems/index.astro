---
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadSiteData } from '../../lib/site-data.js';
import { bootCapture, isCaptured } from '@lib/fleet.js';

const { fleet } = loadSiteData();

// What this page calls a capture is the machine's BOOT capture, asked for by
// kind through the fleet module — never a positional pick from entry.captures,
// which answers by array order rather than by anything true about the machine,
// and would let a software screenshot stand in for a boot the machine never
// completed. That pick drove the card's image and rights note too, not just
// the count.
//
// hasImage is computed once, at the model layer (boot-screenshots.js's
// normalizer), never re-derived here — a capture record and a capture that
// exists are two different states. A record with no image is "waiting on
// media", which is a different, equally honest state from "no record at
// all": never collapse the two into one label. Both states are live here —
// the Sord M5 holds a record it cannot yet fill, because its Monitor ROM
// paints nothing without a cartridge.
const cards = fleet.map((entry) => {
  const capture = bootCapture(entry);
  const hasImage = isCaptured(entry);
  const state = !capture ? 'none' : hasImage ? 'captured' : 'waiting';
  const pendingLabel = capture?.capture?.mediaEnv ? 'Waiting on local media' : 'Capture pending';
  return { entry, capture, hasImage, state, pendingLabel };
});

const capturedCount = cards.filter((card) => card.state === 'captured').length;
const uncapturedCount = cards.length - capturedCount;

// A silent gap is what this rebuild exists to remove: when a machine has no
// image, the fleet list says so on its own card, but the page also names it
// here, once, with the reason a reader can act on rather than a bare count.
const uncapturedCards = cards.filter((card) => card.state !== 'captured');
const uncapturedNotes = uncapturedCards.map(({ entry, capture }) => {
  if (!capture) {
    return `${entry.machineId} (no capture attempt is recorded yet)`;
  }
  const mediaEnv = capture.capture?.mediaEnv;
  const mediaLabel = capture.capture?.mediaLabel ?? 'media';
  return mediaEnv
    ? `${entry.machineId} (waiting on a locally supplied ${mediaLabel} — set ${mediaEnv} to publish it)`
    : `${entry.machineId} (no image yet)`;
});

// Some machines cover more than one hardware variant, each with its own
// capture and its own rights note — read per-machine from the fleet entry,
// never re-driven from the site's flat capture list.
const variantRows = fleet.flatMap((entry) => {
  const capture = bootCapture(entry);
  if (!capture) return [];
  return (capture.variants ?? []).map((variant) => ({ machineId: entry.machineId, variant }));
});
---

<BaseLayout title="System Matrix" description="Current Emu198x system support matrix.">
  <main class="container systems" data-pagefind-body>
    <header>
      <p class="eyebrow">Fleet status</p>
      <h1>System matrix</h1>
      <p>
        Emu198x separates support into capability surfaces. Primary systems have
        native windows; extended systems are headless but scriptable and
        MCP-driven. This page lists every machine in the flagship's registry,
        with a boot capture where one exists.
      </p>
    </header>

    <section class="stat-grid" aria-label="Registry summary">
      <div class="stat"><strong>{cards.length}</strong><span>machines in the registry</span></div>
      <div class="stat"><strong>{capturedCount}</strong><span>with a boot capture</span></div>
      <div class="stat"><strong>{uncapturedCount}</strong><span>no capture yet</span></div>
    </section>

    <section class="panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Registry</p>
          <h2>Every machine, one card each</h2>
        </div>
        <a href="/accuracy/">Accuracy progress</a>
      </div>
      <div class="capture-grid">
        {cards.map(({ entry, capture, hasImage, state, pendingLabel }) => (
          <article class="capture-card">
            <a
              class="frame"
              href={`/systems/${entry.machineId}/`}
              aria-label={`${entry.machineId} system page`}
            >
              {hasImage ? (
                <img
                  src={capture.image}
                  alt={`${capture.title ?? `${capture.name} boot`} screenshot`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span>{capture ? pendingLabel : 'No capture yet'}</span>
              )}
            </a>
            <div class="capture-card-copy">
              <div>
                <p class="tier">{entry.crate}</p>
                <h3><a href={`/systems/${entry.machineId}/`}>{entry.machineId}</a></h3>
              </div>
              {hasImage && <p class="rights-note">{capture.rightsNote}</p>}
              <p class="capture-state">
                {state === 'captured' ? 'Capture available' : state === 'waiting' ? pendingLabel : 'No capture yet'}
              </p>
            </div>
          </article>
        ))}
      </div>
      {uncapturedCount > 0 ? (
        <p class="uncaptured-note">
          {uncapturedCount} of {cards.length} machines in the registry {uncapturedCount === 1 ? 'still has' : 'still have'} no capture:{' '}
          {uncapturedNotes.join('; ')}.
          {uncapturedCards.some((card) => card.entry.machineId === 'sord-m5') && (
            <>
              {' '}
              The Sord M5's own firmware leaves the screen blank on its own — it needs a
              cartridge to paint anything — so this one stays honestly uncaptured until local
              cartridge media is supplied.
            </>
          )}
        </p>
      ) : (
        <p class="uncaptured-note">Every machine in the registry has a capture.</p>
      )}
    </section>

    {variantRows.length > 0 && (
      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Variant catalogue</p>
            <h2>Machine variants with their own capture</h2>
          </div>
        </div>
        <p>
          Some machines in the registry cover more than one hardware variant,
          each captured and rights-noted separately.
        </p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Machine variants and their captures">
          <table>
            <thead>
              <tr>
                <th>Machine</th>
                <th>Variant</th>
                <th>Capture</th>
                <th>Source</th>
                <th>Rights note</th>
              </tr>
            </thead>
            <tbody>
              {variantRows.map(({ machineId, variant }) => (
                <tr>
                  <td><a href={`/systems/${machineId}/`}>{machineId}</a></td>
                  <td>{variant.name}</td>
                  <td>{variant.hasImage ? variant.title : `${variant.title} (waiting on local media)`}</td>
                  <td>{variant.provenance.source}</td>
                  <td class="rights-note-cell">
                    {variant.hasImage
                      ? variant.rightsNote
                      : 'No capture yet — waiting on local media, so there is nothing to assert rights over.'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .systems {
    padding-top: 4rem;
  }

  header {
    max-width: 880px;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.92;
  }

  header p:last-child {
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .stat-grid {
    margin-top: 2rem;
  }

  .panel {
    margin-top: 2rem;
    border-radius: var(--radius);
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-sm);
  }

  .panel-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .panel-heading h2,
  h2 {
    margin: 0;
  }

  .panel-heading a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-weight: 650;
    white-space: nowrap;
  }

  .frame {
    display: grid;
    min-height: 164px;
    aspect-ratio: 4 / 3;
    place-items: center;
    overflow: hidden;
    background: #14161b;
    color: #d5dae3;
    text-decoration: none;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .frame span {
    max-width: 18ch;
    padding: 0.75rem;
    color: #d5dae3;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .capture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }

  .capture-card {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-strong);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-sm);
  }

  .capture-card-copy {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }

  .tier {
    margin: 0 0 0.2rem;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .capture-card-copy p {
    margin: 0;
    line-height: 1.45;
  }

  .capture-state {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    width: fit-content;
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .rights-note {
    display: block;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .uncaptured-note {
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .rights-note-cell {
    min-width: 260px;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .panel-heading {
      align-items: start;
      flex-direction: column;
    }

    .capture-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
