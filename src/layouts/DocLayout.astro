---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

/**
 * The documentation set, in reading order: the machine first, then the four
 * ways to drive it without watching it, then the two pages that are about
 * getting and tracking builds rather than using one.
 */
const links = [
  { label: 'Getting Started', href: '/docs/getting-started/' },
  { label: 'MCP', href: '/docs/mcp/' },
  { label: 'Scripting', href: '/docs/scripting/' },
  { label: 'Capture', href: '/docs/capture/' },
  { label: 'Observability', href: '/docs/observability/' },
  { label: 'Downloads', href: '/downloads/' },
  { label: 'Changelog', href: '/docs/changelog/' },
];

// aria-current carries the current page to a screen reader; the .current rule
// below carries it to a sighted reader as weight and a rule down the left
// edge. Colour alone would leave both readers who cannot see it and readers
// in a theme where the shade is close guessing which page they are on.
const here = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <main class="doc-shell container">
    <nav class="doc-nav" aria-label="Documentation" data-pagefind-ignore>
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['doc-nav-link', { current: here === link.href }]}
          aria-current={here === link.href ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>
    <article class="doc-content" data-pagefind-body>
      <slot />
    </article>
  </main>
</BaseLayout>

<style>
  .doc-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 3rem;
    padding-top: 3rem;
  }

  .doc-nav {
    position: sticky;
    top: 90px;
    display: flex;
    height: fit-content;
    flex-direction: column;
    gap: 0.2rem;
  }

  .doc-nav-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    border-radius: 6px;
    padding: 0 0.75rem;
    color: var(--ink-muted);
    font-size: 0.93rem;
    font-weight: 620;
    text-decoration: none;
  }

  /* The current page carries three cues: aria-current for a screen reader, a
     heavier weight, and a rule down the left edge. Colour on its own is the
     one cue a reader who cannot see it never gets. */
  .doc-nav-link.current {
    box-shadow: inset 3px 0 0 var(--accent);
    color: var(--ink);
    font-weight: 800;
  }

  .doc-content {
    min-width: 0;
    max-width: 860px;
    /* Long-form reading is Literata's job in the family type roster; headings
       below stay in Archivo, which is the interface face. See
       198x/decisions/family-visual-identity.md §4. */
    font-family: var(--font-read);
  }

  .doc-content :global(h1) {
    font-family: var(--font-sans);
    margin: 0 0 1rem;
    color: var(--ink);
    font-size: clamp(2.1rem, 6vw, 4.2rem);
    line-height: 0.98;
  }

  .doc-content :global(h2) {
    font-family: var(--font-sans);
    margin-top: 2.4rem;
    padding-top: 0.4rem;
    color: var(--ink);
    font-size: 1.55rem;
  }

  .doc-content :global(h3) {
    font-family: var(--font-sans);
    margin-top: 1.8rem;
    color: var(--ink);
  }

  .doc-content :global(p),
  .doc-content :global(li) {
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .doc-content :global(blockquote) {
    margin: 1.5rem 0;
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    color: var(--ink-muted);
  }

  .doc-content :global(.data-footnote-backref) {
    font-size: 0.85rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .doc-nav-link:hover {
      background: color-mix(in oklab, var(--h-accent) 10%, transparent);
      color: var(--accent-strong);
    }
  }

  @media (max-width: 860px) {
    .doc-shell {
      display: block;
      padding-top: 2rem;
    }

    .doc-nav {
      position: static;
      flex-direction: row;
      overflow-x: auto;
      margin-bottom: 2rem;
      padding-bottom: 0.4rem;
    }

    .doc-nav-link {
      white-space: nowrap;
    }
  }
</style>
