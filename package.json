{
  "name": "emu198x.github.io",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "ui:fetch": "./scripts/fetch-ui.sh",
    "predev": "npm run ui:fetch",
    "dev": "node scripts/sync-public-docs.mjs && astro dev",
    "prebuild": "npm run ui:fetch",
    "build": "node scripts/sync-public-docs.mjs && astro build && node scripts/check-routes.mjs && node scripts/check-rendered-spacing.mjs && node scripts/check-internal-links.mjs && npx pagefind --site dist",
    "check:spacing": "node scripts/check-rendered-spacing.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "capture:screenshots": "node scripts/capture-boot-screenshots.mjs",
    "preview": "astro preview",
    "sync": "node scripts/sync-public-docs.mjs",
    "a11y": "node scripts/a11y-sweep.mjs",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.3",
    "pagefind": "^1.5.2",
    "smol-toml": "1.7.0"
  },
  "optionalDependencies": {
    "@pagefind/darwin-arm64": "^1.5.2"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
